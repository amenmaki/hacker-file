cat << 'EOF' > instainsane_ext.sh
#!/usr/bin/env bash

# instainsane_ext.sh - Authorized Instagram OSINT, Session & Wordlist Audit Module
# For defensive security study and accounts/assets you own or are authorized to inspect.

set -o pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
DIM='\033[2m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$SCRIPT_DIR/logs"
mkdir -p "$LOG_DIR"
SESSION_ID="$(date +%Y%m%d_%H%M%S)"
LOG_FILE="$LOG_DIR/instainsane_audit_${SESSION_ID}.log"

log_event() {
    local tag="$1"
    shift
    local msg="$*"
    local plain
    plain=$(echo -e "$msg" | sed -r 's/\x1B\[[0-9;]*[mK]//g')
    printf "[%s] [%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$tag" "$plain" >> "$LOG_FILE"
    echo -e "$msg"
}

pause_key() {
    echo ""
    read -r -p "$(echo -e "${DIM}Press Enter to continue...${NC}")"
}

banner() {
    clear
    echo -e "${RED}  ___ _   _ ____ _____  _    ___ _   _ ____    _    _   _ _____ ${NC}"
    echo -e "${YELLOW} |_ _| \ | / ___|_   _|/ \  |_ _| \ | / ___|  / \  | \ | | ____|${NC}"
    echo -e "${GREEN}  | ||  \| \___ \ | | / _ \  | ||  \| \___ \ / _ \ |  \| |  _|  ${NC}"
    echo -e "${CYAN}  | || |\  |___) || |/ ___ \ | || |\  |___) / ___ \| |\  | |___ ${NC}"
    echo -e "${MAGENTA} |___|_| \_|____/ |_/_/   \_\___|_| \_|____/_/   \_\_| \_|_____|${NC}"
    echo -e "${WHITE}      [ Authorized Account & OSINT Audit Module - hacker-file ]${NC}"
    echo -e "${DIM}      Log File: $LOG_FILE${NC}"
    echo -e "${CYAN}====================================================================${NC}"
}

check_public_endpoint() {
    banner
    echo -e "${CYAN}--- [1] Public Profile Reachability Check ---${NC}"
    read -r -p "Enter public Instagram username (without @): " uname
    uname=$(echo "$uname" | tr -d '[:space:]')
    if [ -z "$uname" ]; then
        log_event "WARN" "${RED}[!] Username cannot be empty.${NC}"
        pause_key
        return
    fi

    if ! command -v curl >/dev/null 2>&1; then
        log_event "ERROR" "${RED}[!] 'curl' is not installed.${NC}"
        pause_key
        return
    fi

    local url="https://www.instagram.com/${uname}/"
    local code
    code=$(curl -s -L -o /dev/null -w "%{http_code}" -A "Mozilla/5.0" --max-time 10 "$url" || echo "000")
    log_event "HTTP-CHECK" "${YELLOW}Target:${NC} $url | ${YELLOW}HTTP Status:${NC} ${GREEN}$code${NC}"
    echo -e "${DIM}Note: Modern social platforms enforce login walls, rate limits, and bot defenses.${NC}"
    pause_key
}

check_wordlist_stats() {
    banner
    echo -e "${CYAN}--- [2] Local Wordlist & Password Hygiene Inspector ---${NC}"
    read -r -p "Enter path to a local wordlist file: " wpath
    if [ ! -f "$wpath" ]; then
        log_event "WARN" "${RED}[!] File not found: $wpath${NC}"
        pause_key
        return
    fi

    local total unique min_len
    total=$(wc -l < "$wpath")
    unique=$(sort -u "$wpath" | wc -l)
    min_len=$(awk 'NF{len=length($0); if(min=="" || len<min) min=len} END{print (min==""?0:min)}' "$wpath")

    log_event "WORDLIST" "${GREEN}File:${NC} $wpath | ${YELLOW}Lines:${NC} $total | ${YELLOW}Unique:${NC} $unique | ${YELLOW}Min Length:${NC} $min_len"
    pause_key
}

check_instaloader_env() {
    banner
    echo -e "${CYAN}--- [3] Instaloader & Session Tooling Check ---${NC}"
    if command -v instaloader >/dev/null 2>&1; then
        log_event "TOOL-OK" "${GREEN}[+] instaloader is installed:${NC} $(instaloader --version 2>&1 | tr '\n' ' ')"
    else
        log_event "TOOL-MISS" "${YELLOW}[!] instaloader not found. Install with: sudo apt install -y instaloader${NC}"
    fi
    pause_key
}

view_audit_log() {
    banner
    echo -e "${CYAN}--- [4] View Current Session Log ---${NC}"
    if [ -f "$LOG_FILE" ]; then
        cat "$LOG_FILE"
    else
        echo "No log entries yet."
    fi
    pause_key
}

while true; do
    banner
    echo -e "${YELLOW}Select an option:${NC}"
    echo -e "${GREEN}  [1]${NC} Public Profile HTTP Reachability Check"
    echo -e "${GREEN}  [2]${NC} Local Wordlist Stats (Line/Unique/Length Audit)"
    echo -e "${GREEN}  [3]${NC} Check Instaloader OSINT Tool Availability"
    echo -e "${GREEN}  [4]${NC} View Current Session Log"
    echo -e "${RED}  [0]${NC} Exit"
    echo ""
    read -r -p "$(echo -e "${WHITE}Choice [0-4]: ${NC}")" opt

    case "$opt" in
        1) check_public_endpoint ;;
        2) check_wordlist_stats ;;
        3) check_instaloader_env ;;
        4) view_audit_log ;;
        0)
            log_event "EXIT" "${CYAN}Exiting module. Log saved at $LOG_FILE${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}[!] Invalid option.${NC}"
            sleep 1
            ;;
    esac
done
EOF
